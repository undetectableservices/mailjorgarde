# Single-origin LAN HTTP gateway for hybrid/local mode.
:6969 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	handle /api/public/inbound* {
		respond "Not found" 404
	}

	handle /auth/v1/* {
		reverse_proxy gateway:8000
	}

	handle /rest/v1/* {
		reverse_proxy gateway:8000
	}

	handle {
		reverse_proxy web:6969
	}
}
