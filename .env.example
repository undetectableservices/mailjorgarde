########################################################################
# JorgardeMail production configuration.
#
# Do not put real secrets in this template. `sudo ./run.sh` installs a
# private copy at /etc/mailjorgarde/mailjorgarde.env (root:root, 0600)
# and generates the secret values on a new installation.
########################################################################

# Persisted topology. One of: hybrid, local, local-https, public-web.
# hybrid is the safe default: one LAN web origin plus public inbound :25.
INSTALL_MODE=
COMPOSE_PROJECT_NAME=mailjorgarde

# Stable, explicitly named volumes. The installer can retain a detected
# legacy database volume by writing its exact name here.
DB_VOLUME_NAME=mailjorgarde_db_data
CADDY_DATA_VOLUME_NAME=mailjorgarde_caddy_data
CADDY_CONFIG_VOLUME_NAME=mailjorgarde_caddy_config
CADDY_LAN_DATA_VOLUME_NAME=mailjorgarde_caddy_lan_data
CADDY_LAN_CONFIG_VOLUME_NAME=mailjorgarde_caddy_lan_config

# LAN binding and browser address. LAN_BIND_ADDRESS must be a non-loopback
# IPv4 address assigned to this host; it is never allowed to be 0.0.0.0.
LAN_BIND_ADDRESS=
WEB_HOSTNAME=
WEB_PORT=6969
HTTPS_LOCAL_PORT=8443

# Stable MX/DDNS hostname used by both recipient domains. In hybrid and
# public-web modes its A record must track the public IP and TCP 25 must
# reach this host. PUBLIC_IP is optional diagnostic information only.
MAIL_HOSTNAME=
PUBLIC_IP=
SMTP_BIND_ADDRESS=
PUBLIC_BIND_ADDRESS=0.0.0.0

# Only used by public-web mode, where Caddy publishes the UI on 80/443.
ACME_EMAIL=

# Persistent SMTP TLS files. The installer creates a local self-signed
# certificate here for opportunistic STARTTLS; it does not claim public
# identity. The key is readable only by root and the SMTP container's numeric
# group. An operator may replace the files with DNS-01-issued ones.
SMTP_TLS_DIR=/var/lib/mailjorgarde/tls
SMTP_TLS_CERT=/smtp-certs/smtp.crt
SMTP_TLS_KEY=/smtp-certs/smtp.key

# Backups are custom-format PostgreSQL dumps plus a protected config copy.
BACKUP_DIR=/var/backups/mailjorgarde
BACKUP_RETENTION_DAYS=14

# Frozen inbound resource contract shared by the SMTP receiver and signed web
# ingestion route. These values are documented here for visibility; this
# release intentionally refuses different values instead of risking drift.
SMTP_MAX_BYTES=10485760
SMTP_MAX_BODY_BYTES=524288
SMTP_MAX_RECIPIENTS=5
SMTP_MAX_ATTACHMENTS=32
SMTP_MAX_ATTACHMENT_BYTES=8388608
SMTP_MAX_DELIVERY_CONCURRENCY=2
INBOUND_MAX_MESSAGE_BYTES=10485760
INBOUND_MAX_BODY_BYTES=524288
INBOUND_MAX_RECIPIENTS=5
INBOUND_MAX_ATTACHMENTS=32
INBOUND_MAX_ATTACHMENT_BYTES=8388608

# Self-hosted backend credentials. The installer creates these only when
# the database volume does not exist. It refuses to invent replacements
# for an existing database because that would lock the deployment out.
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
AUTH_ADMIN_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
INBOUND_WEBHOOK_SECRET=

# Derived by the installer from INSTALL_MODE. Do not hand-edit unless you
# understand the browser build-time URL contract.
SUPABASE_PUBLIC_URL=
SITE_URL=
